#!/usr/bin/env bash

set -u

EXECUTABLE="$1"
REPORT="$2"
FAKE_INKSCAPE_PATH="$(mktemp -d)"

mkdir -p "$(dirname "$REPORT")"
: >"$REPORT"
set +e
PYTHONPATH="$FAKE_INKSCAPE_PATH" INKSTITCH_DEBUG_IMPORTS_FILE="$REPORT" "$EXECUTABLE" --extension __import_debug_probe__
STATUS=$?
set -e

cat "$REPORT"

grep -q "sys.frozen=True" "$REPORT"
grep -q "INKEX IMPORT DEBUG: before reorder" "$REPORT"
grep -q "INKEX IMPORT DEBUG: after reorder" "$REPORT"
grep -q "inkex.__file__=" "$REPORT"
! grep -q "inkex.__file__=.*$FAKE_INKSCAPE_PATH" "$REPORT"

rm -rf "$FAKE_INKSCAPE_PATH"

if [[ "$STATUS" -ne 0 ]]; then
    echo "ERROR: frozen import test failed with exit status $STATUS" >&2
    exit 1
fi

echo "PASS: frozen executable imported bundled inkex"
